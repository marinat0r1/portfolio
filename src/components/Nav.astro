---
const links = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" },
];
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === "/") return currentPath === "/" || currentPath === "";
  return currentPath.startsWith(href);
};
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="MH Home">MH</a>

    <!-- Desktop Nav -->
    <nav aria-label="Primary Navigation" class="desktop-nav">
      <ul class="nav-list">
        {links.map((l) => (
          <li>
            <a class={isCurrent(l.href) ? "active" : ""} href={l.href}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href="/about#contact" class="btn-minimal">Contact</a>

      <!-- Mobile Hamburger Toggle -->
      <button
        id="mobile-nav-toggle"
        class="mobile-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <span class="hamburger-box">
          <span class="hamburger-line line-1"></span>
          <span class="hamburger-line line-2"></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Nav Drawer -->
  <div id="mobile-nav-drawer" class="mobile-nav-drawer" aria-hidden="true">
    <div class="container mobile-drawer-inner">
      <nav aria-label="Mobile Navigation">
        <ul class="mobile-nav-list">
          {links.map((l) => (
            <li>
              <a class={isCurrent(l.href) ? "active" : ""} href={l.href}>
                <span>{l.label}</span>
                <span class="nav-arrow">→</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="mobile-drawer-cta">
        <a href="/about#contact" class="btn btn-primary w-full">Start a Project</a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');

  if (header && toggleBtn && drawer) {
    const toggleMenu = (open?: boolean) => {
      const isCurrentlyOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
      const willOpen = open !== undefined ? open : !isCurrentlyOpen;

      toggleBtn.setAttribute('aria-expanded', String(willOpen));
      drawer.setAttribute('aria-hidden', String(!willOpen));
      header.classList.toggle('nav-open', willOpen);
      document.body.classList.toggle('no-scroll', willOpen);
    };

    toggleBtn.addEventListener('click', () => toggleMenu());

    // Close when tapping any link inside mobile drawer
    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => toggleMenu(false));
    });

    // Close on Escape key press
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        toggleMenu(false);
      }
    });

    // Close when resizing viewport above mobile breakpoint (768px)
    window.addEventListener('resize', () => {
      if (window.innerWidth > 768 && toggleBtn.getAttribute('aria-expanded') === 'true') {
        toggleMenu(false);
      }
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border);
    height: var(--header-height);
    display: flex;
    align-items: center;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .brand {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--color-text-primary);
    text-decoration: none;
    padding: var(--space-2) 0;
    display: inline-flex;
    align-items: center;
  }

  .desktop-nav {
    display: block;
  }

  .nav-list {
    list-style: none;
    display: flex;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
  }

  .nav-list a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: var(--space-2) 0;
    position: relative;
    transition: color 0.2s ease;
  }

  .nav-list a:hover,
  .nav-list a.active {
    color: var(--color-text-primary);
  }

  .nav-list a.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-text-primary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .btn-minimal {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: var(--radius-sm);
    background: var(--color-text-primary);
    color: var(--color-bg);
    text-decoration: none;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    transition: opacity 0.2s ease;
  }

  .btn-minimal:hover {
    opacity: 0.9;
    text-decoration: none;
  }

  /* Hamburger Toggle */
  .mobile-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    width: 40px;
    height: 40px;
    padding: 0;
    cursor: pointer;
    color: var(--color-text-primary);
    transition: border-color 0.2s ease, background-color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-toggle:hover {
    border-color: var(--color-border-hover);
    background: rgba(255, 255, 255, 0.05);
  }

  .hamburger-box {
    width: 18px;
    height: 14px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hamburger-line {
    display: block;
    width: 100%;
    height: 1.75px;
    background: var(--color-text-primary);
    border-radius: 1px;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
    transform-origin: center;
  }

  /* Animated Morph to X */
  .site-header.nav-open .hamburger-line.line-1 {
    transform: translateY(6px) rotate(45deg);
  }

  .site-header.nav-open .hamburger-line.line-2 {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile Drawer */
  .mobile-nav-drawer {
    display: none;
  }

  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }

    .mobile-toggle {
      display: inline-flex;
    }

    .mobile-nav-drawer {
      display: block;
      position: fixed;
      top: var(--header-height);
      left: 0;
      right: 0;
      background: rgba(8, 8, 8, 0.96);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--color-border);
      padding: var(--space-4) 0 var(--space-6);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      pointer-events: none;
      transition: opacity 0.22s ease, transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.22s ease;
      max-height: calc(100vh - var(--header-height));
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    .site-header.nav-open .mobile-nav-drawer {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
    }

    .mobile-drawer-inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .mobile-nav-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
    }

    .mobile-nav-list li {
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .mobile-nav-list a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 50px;
      font-size: 1.1rem;
      font-weight: 500;
      color: var(--color-text-secondary);
      text-decoration: none;
      padding: var(--space-2) 0;
      transition: color 0.15s ease;
    }

    .mobile-nav-list a .nav-arrow {
      font-size: 1rem;
      color: var(--color-text-muted);
      transition: transform 0.2s ease, color 0.2s ease;
    }

    .mobile-nav-list a:hover,
    .mobile-nav-list a.active {
      color: var(--color-text-primary);
    }

    .mobile-nav-list a.active .nav-arrow {
      color: var(--color-text-primary);
      transform: translateX(2px);
    }

    .mobile-drawer-cta {
      padding-top: var(--space-2);
    }

    .mobile-drawer-cta .btn {
      width: 100%;
      height: 48px;
      font-size: 1rem;
    }
  }
</style>
