---

---

<div class="rubiks-cube-container" data-rubiks-cube></div>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js";
  import { RoundedBoxGeometry } from "three/examples/jsm/geometries/RoundedBoxGeometry.js";
  import { gsap } from "gsap";

  // ---------------------------------------------------------------------
  // Each call builds one fully independent cube inside `container` and
  // returns a destroy() function that releases every resource it created.
  // ---------------------------------------------------------------------
  function initRubiksCube(container: HTMLElement): () => void {
    let disposed = false;
    let rafId = 0;
    let moveTimer: ReturnType<typeof setTimeout> | undefined;
    let driftTimer: ReturnType<typeof setTimeout> | undefined;
    let sliceTween: gsap.core.Tween | undefined;
    let driftTween: gsap.core.Tween | undefined;

    // --- RENDERER ---
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(
      35,
      container.clientWidth / container.clientHeight,
      0.1,
      1000,
    );
    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });

    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.8;
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    container.appendChild(renderer.domElement);

    // --- ORBIT CONTROLS ---
    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.enableZoom = false;
    controls.enablePan = false;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 4.0;
    controls.minPolarAngle = Math.PI / 4;
    controls.maxPolarAngle = (3 * Math.PI) / 4;

    // --- STUDIO ENVIRONMENT MAP ---
    function createStudioEnvironment(): THREE.Scene {
      const envScene = new THREE.Scene();
      const geo = new THREE.BoxGeometry();
      geo.deleteAttribute("uv");

      const positions = [
        { pos: [-8, 12, 12], scale: [30, 30, 1], color: 0xffffff }, // Key
        { pos: [12, 6, -12], scale: [25, 12, 1], color: 0x99ccff }, // Rim cool
        { pos: [0, -14, 8], scale: [25, 25, 1], color: 0xfff0dd }, // Fill warm
        { pos: [0, 20, 0], scale: [40, 1, 40], color: 0xeeeeff }, // Top
        { pos: [-12, 0, -8], scale: [1, 20, 20], color: 0xe8e8e8 }, // Left
        { pos: [12, 0, 8], scale: [1, 20, 20], color: 0xddeeff }, // Right
        { pos: [0, 0, -15], scale: [20, 20, 1], color: 0xccccdd }, // Back
      ];
      positions.forEach(({ pos, scale, color }) => {
        const panel = new THREE.Mesh(
          geo,
          new THREE.MeshBasicMaterial({ color, toneMapped: false }),
        );
        panel.scale.set(scale[0], scale[1], scale[2]);
        panel.position.set(pos[0], pos[1], pos[2]);
        if (scale[0] !== 1 && scale[1] !== 1) panel.lookAt(0, 0, 0);
        envScene.add(panel);
      });

      return envScene;
    }

    const pmremGenerator = new THREE.PMREMGenerator(renderer);
    const envScene = createStudioEnvironment();
    scene.environment = pmremGenerator.fromScene(envScene, 0.04).texture;
    envScene.traverse((o: any) => {
      if (o.geometry) o.geometry.dispose();
      if (o.material) o.material.dispose();
    });
    pmremGenerator.dispose();

    // --- CANVAS TEXTURE GENERATORS ---
    // Every texture is tracked so destroy() can dispose it.
    const textures: THREE.Texture[] = [];
    const track = (t: THREE.CanvasTexture): THREE.CanvasTexture => {
      textures.push(t);
      return t;
    };

    // 1. Perforated / dotted pattern
    function createPerforatedTexture() {
      const size = 512;
      const canvas = document.createElement("canvas");
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext("2d")!;

      ctx.fillStyle = "#0a0a0a";
      ctx.fillRect(0, 0, size, size);

      const dotSpacing = 22;
      const dotRadius = 4.5;
      ctx.fillStyle = "#383838";

      for (let y = dotSpacing / 2; y < size; y += dotSpacing) {
        for (let x = dotSpacing / 2; x < size; x += dotSpacing) {
          ctx.beginPath();
          ctx.arc(x, y, dotRadius, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      const map = track(new THREE.CanvasTexture(canvas));
      map.colorSpace = THREE.SRGBColorSpace;
      map.wrapS = THREE.RepeatWrapping;
      map.wrapT = THREE.RepeatWrapping;

      const bumpCanvas = document.createElement("canvas");
      bumpCanvas.width = size;
      bumpCanvas.height = size;
      const bctx = bumpCanvas.getContext("2d")!;
      bctx.fillStyle = "#000000";
      bctx.fillRect(0, 0, size, size);
      bctx.fillStyle = "#ffffff";
      for (let y = dotSpacing / 2; y < size; y += dotSpacing) {
        for (let x = dotSpacing / 2; x < size; x += dotSpacing) {
          bctx.beginPath();
          bctx.arc(x, y, dotRadius + 1, 0, Math.PI * 2);
          bctx.fill();
        }
      }
      const bumpMap = track(new THREE.CanvasTexture(bumpCanvas));
      bumpMap.wrapS = THREE.RepeatWrapping;
      bumpMap.wrapT = THREE.RepeatWrapping;

      return { map, bumpMap };
    }

    // 2. Fine mesh / grill pattern
    function createMeshTexture() {
      const size = 512;
      const canvas = document.createElement("canvas");
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext("2d")!;

      ctx.fillStyle = "#080808";
      ctx.fillRect(0, 0, size, size);

      const gridSize = 14;
      ctx.strokeStyle = "#333333";
      ctx.lineWidth = 1.5;

      for (let i = 0; i <= size; i += gridSize) {
        ctx.beginPath();
        ctx.moveTo(i, 0);
        ctx.lineTo(i, size);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(0, i);
        ctx.lineTo(size, i);
        ctx.stroke();
      }

      const map = track(new THREE.CanvasTexture(canvas));
      map.colorSpace = THREE.SRGBColorSpace;
      map.wrapS = THREE.RepeatWrapping;
      map.wrapT = THREE.RepeatWrapping;

      const bumpCanvas = document.createElement("canvas");
      bumpCanvas.width = size;
      bumpCanvas.height = size;
      const bctx = bumpCanvas.getContext("2d")!;
      bctx.fillStyle = "#000000";
      bctx.fillRect(0, 0, size, size);
      bctx.strokeStyle = "#aaaaaa";
      bctx.lineWidth = 1.5;
      for (let i = 0; i <= size; i += gridSize) {
        bctx.beginPath();
        bctx.moveTo(i, 0);
        bctx.lineTo(i, size);
        bctx.stroke();
        bctx.beginPath();
        bctx.moveTo(0, i);
        bctx.lineTo(size, i);
        bctx.stroke();
      }
      const bumpMap = track(new THREE.CanvasTexture(bumpCanvas));
      bumpMap.wrapS = THREE.RepeatWrapping;
      bumpMap.wrapT = THREE.RepeatWrapping;

      return { map, bumpMap };
    }

    // 3. Brushed metal / carbon fiber texture
    function createBrushedTexture() {
      const size = 512;
      const canvas = document.createElement("canvas");
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext("2d")!;

      ctx.fillStyle = "#090909";
      ctx.fillRect(0, 0, size, size);

      for (let y = 0; y < size; y += 2) {
        const brightness = Math.floor(Math.random() * 30) + 18;
        ctx.strokeStyle = `rgb(${brightness}, ${brightness}, ${brightness})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(0, y + Math.random() * 0.5);
        ctx.lineTo(size, y + Math.random() * 0.5);
        ctx.stroke();
      }

      const map = track(new THREE.CanvasTexture(canvas));
      map.colorSpace = THREE.SRGBColorSpace;
      map.wrapS = THREE.RepeatWrapping;
      map.wrapT = THREE.RepeatWrapping;

      const bumpCanvas = document.createElement("canvas");
      bumpCanvas.width = size;
      bumpCanvas.height = size;
      const bctx = bumpCanvas.getContext("2d")!;
      bctx.fillStyle = "#000000";
      bctx.fillRect(0, 0, size, size);
      for (let y = 0; y < size; y += 2) {
        const val = Math.floor(Math.random() * 60) + 20;
        bctx.strokeStyle = `rgb(${val}, ${val}, ${val})`;
        bctx.lineWidth = 1;
        bctx.beginPath();
        bctx.moveTo(0, y);
        bctx.lineTo(size, y);
        bctx.stroke();
      }
      const bumpMap = track(new THREE.CanvasTexture(bumpCanvas));
      bumpMap.wrapS = THREE.RepeatWrapping;
      bumpMap.wrapT = THREE.RepeatWrapping;

      return { map, bumpMap };
    }

    // --- MATERIALS (4 types) ---
    const polishedMaterial = new THREE.MeshPhysicalMaterial({
      color: 0x111111,
      roughness: 0.03,
      metalness: 0.15,
      clearcoat: 1.0,
      clearcoatRoughness: 0.03,
      reflectivity: 1.0,
      envMapIntensity: 2.0,
    });

    const perfTextures = createPerforatedTexture();
    const perforatedMaterial = new THREE.MeshPhysicalMaterial({
      color: 0x141414,
      map: perfTextures.map,
      bumpMap: perfTextures.bumpMap,
      bumpScale: 0.06,
      roughness: 0.5,
      metalness: 0.4,
      clearcoat: 0.5,
      clearcoatRoughness: 0.2,
      envMapIntensity: 1.2,
    });

    const meshTextures = createMeshTexture();
    const meshMaterial = new THREE.MeshPhysicalMaterial({
      color: 0x141414,
      map: meshTextures.map,
      bumpMap: meshTextures.bumpMap,
      bumpScale: 0.05,
      roughness: 0.35,
      metalness: 0.8,
      clearcoat: 0.7,
      clearcoatRoughness: 0.15,
      envMapIntensity: 1.5,
    });

    const brushedTextures = createBrushedTexture();
    const brushedMaterial = new THREE.MeshPhysicalMaterial({
      color: 0x121212,
      map: brushedTextures.map,
      bumpMap: brushedTextures.bumpMap,
      bumpScale: 0.04,
      roughness: 0.3,
      metalness: 0.95,
      clearcoat: 0.4,
      clearcoatRoughness: 0.3,
      envMapIntensity: 1.6,
    });

    const materialPool = [
      polishedMaterial,
      perforatedMaterial,
      meshMaterial,
      brushedMaterial,
    ];

    // --- GEOMETRY ---
    // FIX 1 + 2: RoundedBoxGeometry extends BoxGeometry, so it has 6 material
    // groups (one per face). The old ExtrudeGeometry only had 2, which meant
    // 4 of the 6 random materials per cubelet were silently ignored.
    // FIX 2: a single geometry is created and shared by all 27 cubelets.
    const subCubeSize = 0.92;
    const bevelRadius = 0.12;
    const segments = 8;
    const offset = subCubeSize + 0.08;

    const sharedGeometry = new RoundedBoxGeometry(
      subCubeSize,
      subCubeSize,
      subCubeSize,
      segments,
      bevelRadius,
    );

    // masterGroup: whole-cube drift. group: holds cubelets, slice turns happen here.
    const masterGroup = new THREE.Group();
    const group = new THREE.Group();
    masterGroup.add(group);

    const allCubes: THREE.Mesh[] = [];

    // How materials are spread over a cubelet's 6 faces.
    //  "caps-sides" : 4 side faces share one material, the 2 opposite z faces
    //                 share another. This matches the original look, where
    //                 neighbouring cubelets read as clearly different tiles.
    //  "cubelet"    : all 6 faces share one material (strongest tile contrast).
    //  "per-face"   : every face is random (busiest, tiles blend together).
    type FaceMode = "caps-sides" | "cubelet" | "per-face";
    let FACE_MODE: FaceMode = "caps-sides";

    const randomMaterial = () =>
      materialPool[Math.floor(Math.random() * materialPool.length)];

    // BoxGeometry face order: +x, -x, +y, -y, +z, -z
    const pickFaceMaterials = (): THREE.MeshPhysicalMaterial[] => {
      const body = randomMaterial();
      const cap = randomMaterial();
      return [body, body, body, body, cap, cap];
    };
    for (let x = -1; x <= 1; x++) {
      for (let y = -1; y <= 1; y++) {
        for (let z = -1; z <= 1; z++) {
          const cube = new THREE.Mesh(sharedGeometry, pickFaceMaterials());
          cube.position.set(x * offset, y * offset, z * offset);
          group.add(cube);
          allCubes.push(cube);
        }
      }
    }
    scene.add(masterGroup);

    // --- LIGHTING ---
    scene.add(new THREE.AmbientLight(0xffffff, 0.5));

    const keyLight = new THREE.DirectionalLight(0xffffff, 4.0);
    keyLight.position.set(-6, 10, 6);
    scene.add(keyLight);

    const rimLight = new THREE.SpotLight(0x8ab4f8, 12.0);
    rimLight.position.set(10, 5, -10);
    rimLight.lookAt(0, 0, 0);
    rimLight.angle = Math.PI / 3;
    rimLight.penumbra = 0.8;
    scene.add(rimLight);

    const fillLight = new THREE.DirectionalLight(0xfff5ee, 2.0);
    fillLight.position.set(0, 0, 10);
    scene.add(fillLight);

    const backFill = new THREE.DirectionalLight(0xddddff, 1.5);
    backFill.position.set(0, 0, -10);
    scene.add(backFill);

    const bottomLight = new THREE.DirectionalLight(0xffeedd, 1.2);
    bottomLight.position.set(0, -10, 0);
    scene.add(bottomLight);

    const topLight = new THREE.PointLight(0xffffff, 3.0, 40);
    topLight.position.set(0, 14, 0);
    scene.add(topLight);

    const leftFill = new THREE.DirectionalLight(0xeeeeff, 1.0);
    leftFill.position.set(-10, 2, 0);
    scene.add(leftFill);

    const rightFill = new THREE.DirectionalLight(0xeeeeff, 1.0);
    rightFill.position.set(10, 2, 0);
    scene.add(rightFill);

    // --- ADAPTIVE CAMERA FRAMING ---
    const dirX = 0.5599;
    const dirY = 0.3876;
    const dirZ = 0.7322;

    const updateCamera = () => {
      const width = container.clientWidth;
      const height = container.clientHeight;
      if (width === 0 || height === 0) return;

      const aspect = width / height;
      camera.aspect = aspect;

      let baseDist = 8.2;
      if (width >= 1400) {
        baseDist = 7.7;
      } else if (width >= 1024) {
        baseDist = 8.2;
      } else if (width >= 768) {
        baseDist = 8.8;
      } else {
        baseDist = 9.4;
      }

      let dist = baseDist;
      if (aspect < 0.95) {
        dist = baseDist * Math.pow(0.95 / aspect, 0.72);
      } else if (aspect > 1.3) {
        dist = Math.max(7.4, baseDist - (aspect - 1.3) * 0.7);
      }

      camera.position.set(dirX * dist, dirY * dist, dirZ * dist);
      camera.lookAt(0, 0, 0);
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    };

    updateCamera();

    // Let mobile users scroll the page vertically through the canvas
    renderer.domElement.style.touchAction = "pan-y";

    // --- MOVE NOTATION & ALGORITHMS ---
    type Move = {
      axis: "x" | "y" | "z";
      index: number;
      dir: number;
      steps: number;
    };

    const notationMap: Record<string, Move> = {
      U: { axis: "y", index: 1, dir: -1, steps: 1 },
      "U'": { axis: "y", index: 1, dir: 1, steps: 1 },
      U2: { axis: "y", index: 1, dir: -1, steps: 2 },
      D: { axis: "y", index: -1, dir: 1, steps: 1 },
      "D'": { axis: "y", index: -1, dir: -1, steps: 1 },
      D2: { axis: "y", index: -1, dir: 1, steps: 2 },
      R: { axis: "x", index: 1, dir: -1, steps: 1 },
      "R'": { axis: "x", index: 1, dir: 1, steps: 1 },
      R2: { axis: "x", index: 1, dir: -1, steps: 2 },
      L: { axis: "x", index: -1, dir: 1, steps: 1 },
      "L'": { axis: "x", index: -1, dir: -1, steps: 1 },
      L2: { axis: "x", index: -1, dir: 1, steps: 2 },
      F: { axis: "z", index: 1, dir: -1, steps: 1 },
      "F'": { axis: "z", index: 1, dir: 1, steps: 1 },
      F2: { axis: "z", index: 1, dir: -1, steps: 2 },
      B: { axis: "z", index: -1, dir: 1, steps: 1 },
      "B'": { axis: "z", index: -1, dir: -1, steps: 1 },
      B2: { axis: "z", index: -1, dir: 1, steps: 2 },
    };

    const algorithms = [
      "R U R' U' R' F R2 U' R' U' R U R' F'", // T-Perm
      "R U R' U R U2 R'", // Sune
      "R U R' F' R U R' U' R' F R2 U' R' U'", // J-Perm
      "R2 U R U R' U' R' U' R' U R'", // U-Perm
      "F R U R' U' F'", // Line OLL
    ];

    let currentAlgorithmIndex = 0;
    let currentMoveSequence: string[] = [];
    let isSliceAnimating = false;

    const getCubesInSlice = (
      axis: "x" | "y" | "z",
      index: number,
    ): THREE.Mesh[] =>
      allCubes.filter(
        (cube) => Math.round(cube.position[axis] / offset) === index,
      );

    const loadNextAlgorithm = () => {
      const algStr = algorithms[currentAlgorithmIndex];
      currentMoveSequence = algStr
        .replace(/[()]/g, "")
        .split(" ")
        .filter((m) => m.length > 0);
      currentAlgorithmIndex = (currentAlgorithmIndex + 1) % algorithms.length;
    };

    // Slice-turn sequencer
    const executeNextMove = () => {
      if (disposed || isSliceAnimating) return;

      if (currentMoveSequence.length === 0) {
        loadNextAlgorithm();
        moveTimer = setTimeout(executeNextMove, 2000);
        return;
      }

      isSliceAnimating = true;
      const moveStr = currentMoveSequence.shift()!;
      const move = notationMap[moveStr];

      if (!move) {
        isSliceAnimating = false;
        executeNextMove();
        return;
      }

      const sliceAngle = (Math.PI / 2) * move.dir * move.steps;
      const sliceDuration = 0.6 + (move.steps - 1) * 0.25;

      const sliceCubes = getCubesInSlice(move.axis, move.index);

      const slicePivot = new THREE.Object3D();
      slicePivot.rotation.set(0, 0, 0);
      group.add(slicePivot);

      sliceCubes.forEach((cube) => slicePivot.attach(cube));

      sliceTween = gsap.to(slicePivot.rotation, {
        [move.axis]: sliceAngle,
        duration: sliceDuration,
        ease: "power2.inOut",
        onComplete: () => {
          for (let i = sliceCubes.length - 1; i >= 0; i--) {
            group.attach(sliceCubes[i]);
          }
          // Snap to the exact grid so float error never accumulates
          sliceCubes.forEach((cube) => {
            cube.position.x = Math.round(cube.position.x / offset) * offset;
            cube.position.y = Math.round(cube.position.y / offset) * offset;
            cube.position.z = Math.round(cube.position.z / offset) * offset;
            cube.rotation.x =
              Math.round(cube.rotation.x / (Math.PI / 2)) * (Math.PI / 2);
            cube.rotation.y =
              Math.round(cube.rotation.y / (Math.PI / 2)) * (Math.PI / 2);
            cube.rotation.z =
              Math.round(cube.rotation.z / (Math.PI / 2)) * (Math.PI / 2);
            cube.updateMatrix();
          });
          group.remove(slicePivot);

          isSliceAnimating = false;
          if (disposed) return;
          moveTimer = setTimeout(executeNextMove, 250 + Math.random() * 100);
        },
      });
    };

    // Whole-cube drift
    const driftWholeCube = () => {
      if (disposed) return;
      const targetX = masterGroup.rotation.x + (Math.random() - 0.5) * Math.PI;
      const targetY = masterGroup.rotation.y + (Math.random() - 0.5) * Math.PI;
      const targetZ =
        masterGroup.rotation.z + (Math.random() - 0.5) * Math.PI * 0.3;

      driftTween = gsap.to(masterGroup.rotation, {
        x: targetX,
        y: targetY,
        z: targetZ,
        duration: 4.0 + Math.random() * 3.0,
        ease: "sine.inOut",
        onComplete: driftWholeCube,
      });
    };

    moveTimer = setTimeout(executeNextMove, 800);
    driftTimer = setTimeout(driftWholeCube, 100);

    // --- RENDER LOOP ---
    const animate = () => {
      rafId = requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    };

    // --- RESIZE ---
    window.addEventListener("resize", updateCamera);
    let ro: ResizeObserver | undefined;
    if (typeof ResizeObserver !== "undefined") {
      ro = new ResizeObserver(() => updateCamera());
      ro.observe(container);
    }

    animate();

    // --- ENTRY ANIMATION ---
    container.classList.add("animate-in");

    // --- FIX 3: TEARDOWN ---
    return function destroy() {
      disposed = true;

      cancelAnimationFrame(rafId);
      clearTimeout(moveTimer);
      clearTimeout(driftTimer);
      sliceTween?.kill();
      driftTween?.kill();

      window.removeEventListener("resize", updateCamera);
      ro?.disconnect();
      controls.dispose();

      sharedGeometry.dispose();
      materialPool.forEach((m) => m.dispose());
      textures.forEach((t) => t.dispose());
      (scene.environment as THREE.Texture | null)?.dispose();
      scene.environment = null;

      renderer.dispose();
      renderer.forceContextLoss();
      renderer.domElement.remove();
      container.classList.remove("animate-in");
    };
  }

  // ---------------------------------------------------------------------
  // FIX 4: mount on every matching element (no more getElementById), and
  // keep a registry so each instance can be destroyed when its page goes
  // away (e.g. with Astro view transitions).
  // ---------------------------------------------------------------------
  const instances = new Map<HTMLElement, () => void>();

  function mountAll() {
    document
      .querySelectorAll<HTMLElement>("[data-rubiks-cube]")
      .forEach((el) => {
        if (!instances.has(el)) instances.set(el, initRubiksCube(el));
      });
  }

  function unmountAll() {
    instances.forEach((destroy) => destroy());
    instances.clear();
  }

  mountAll();
  document.addEventListener("astro:page-load", mountAll);
  document.addEventListener("astro:before-swap", unmountAll);
</script>

<style>
  .rubiks-cube-container {
    width: 100%;
    height: 640px;
    max-width: 620px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transform: scale(0.9);
    transition: none;
    cursor: grab;
    outline: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .rubiks-cube-container:active {
    cursor: grabbing;
  }

  .rubiks-cube-container.animate-in {
    animation: scaleInFade 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes scaleInFade {
    0% {
      opacity: 0;
      transform: scale(0.85);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (min-width: 1440px) {
    .rubiks-cube-container {
      height: 700px;
      max-width: 680px;
    }
  }

  @media (max-width: 1200px) {
    .rubiks-cube-container {
      height: 520px;
      max-width: 500px;
    }
  }

  @media (max-width: 1024px) {
    .rubiks-cube-container {
      height: 440px;
      max-width: 440px;
    }
  }

  @media (max-width: 768px) {
    .rubiks-cube-container {
      height: 350px;
      max-width: 360px;
    }
  }

  @media (max-width: 480px) {
    .rubiks-cube-container {
      height: 310px;
      max-width: 320px;
    }
  }
</style>
