---
import BaseLayout from "../layouts/BaseLayout.astro";

// Core philosophies of the developer extracted for consistency
const philosophies = [
  {
    title: "Strategy First",
    text: "Every line of code serves a business objective.",
  },
  { title: "Excellence", text: "Fast, secure, and accessible by default." },
];
---

<BaseLayout
  title="About — The Vision Behind the Code"
  description="Learn about my philosophy of digital excellence and how I help businesses succeed online."
>
  <div class="container section-py">
    <div class="about-grid">
      <div class="about-text">
        <h1 class="hero-title mb-6">
          Crafting <span class="text-gradient">Digital Success</span>
        </h1>
        <p class="text-secondary text-xl mb-4 leading-relaxed">
          I'm a developer who believes that a website should be more than just a
          digital business card. It should be your hardest-working employee.
        </p>
        <p class="text-secondary text-lg mb-8 leading-relaxed">
          With a background in performance-driven development and user-centric
          design, I specialize in bridging the gap between complex technology
          and business goals.
        </p>

        <!-- Development Philosophy Cards -->
        <div class="philosophy-cards">
          {
            philosophies.map((p) => (
              <div class="p-6 glass">
                <h3>{p.title}</h3>
                <p class="text-muted">{p.text}</p>
              </div>
            ))
          }
        </div>

        <section id="contact" class="glass contact-section p-10 mt-10">
          <h2 class="text-2xl font-bold mb-3">Let's Build Something Great</h2>
          <p class="text-secondary mb-6">
            Ready to grow your business with a premium website?
          </p>
          <div class="contact-actions flex gap-4 items-center">
            <a href="mailto:marin.petru.hincu@gmail.com" class="btn btn-primary"
              >Book a Call</a
            >
            <a
              href="https://linkedin.com"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link text-muted hover:text-white transition-colors"
              >LinkedIn</a
            >
          </div>
        </section>
      </div>

      <div class="about-visual">
        <div class="visual-placeholder glass">
          <span>MH</span>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .hero-title {
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    line-height: 1.15;
    letter-spacing: -0.04em;
    word-break: break-word;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-10);
    align-items: center;
  }

  .visual-placeholder {
    aspect-ratio: 1;
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
    display: grid;
    place-items: center;
    font-size: 3rem;
    font-weight: 800;
    color: var(--color-text-muted);
  }

  .text-xl {
    font-size: clamp(1.1rem, 2.5vw, 1.25rem);
  }
  .text-lg {
    font-size: clamp(0.95rem, 2vw, 1.125rem);
  }
  .leading-relaxed {
    line-height: 1.6;
  }
  .p-6 {
    padding: var(--space-5);
  }
  .p-10 {
    padding: var(--space-8);
  }
  .flex {
    display: flex;
  }
  .items-center {
    align-items: center;
  }
  .gap-4 {
    gap: 1rem;
  }
  .mb-3 {
    margin-bottom: 0.75rem;
  }
  .mb-4 {
    margin-bottom: 1rem;
  }
  .mb-6 {
    margin-bottom: 1.5rem;
  }
  .mb-8 {
    margin-bottom: 2rem;
  }
  .mt-10 {
    margin-top: 2.5rem;
  }

  .contact-section {
    scroll-margin-top: calc(var(--header-height) + var(--space-5));
    border-color: rgba(255, 255, 255, 0.1);
  }

  .contact-link {
    font-size: 0.95rem;
    padding: var(--space-2) var(--space-3);
  }

  /* --- Responsive Grid for Philosophies --- */
  .philosophy-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .philosophy-cards h3 {
    font-size: 1.15rem;
    margin-bottom: var(--space-2);
  }

  .philosophy-cards p {
    font-size: 0.9rem;
    line-height: 1.5;
  }

  @media (max-width: 968px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .about-visual {
      order: -1;
      max-width: 160px;
      margin-inline: auto;
    }
    .visual-placeholder {
      font-size: 2rem;
      max-width: 160px;
    }
  }

  @media (max-width: 600px) {
    .philosophy-cards {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .p-6 {
      padding: var(--space-4);
    }
    .p-10 {
      padding: var(--space-5) var(--space-4);
    }
    .contact-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .contact-actions .btn {
      width: 100%;
    }
    .contact-link {
      text-align: center;
    }
  }
</style>
